# ============================================================
# Street Interface · Public Streetscape Analysis
# Environment template
# ============================================================
#
# Copy this file to `.env` for local development.
#
# IMPORTANT:
# - Do not commit your real `.env`.
# - Do not place real API keys or service tokens in this file
#   before publishing the repository.
# ============================================================


# ------------------------------------------------------------
# Optional AI Studio / Gemini compatibility
# ------------------------------------------------------------
#
# The primary public VM → VLM → SIM pipeline does not require
# Gemini. These values are retained for inherited server-side
# Gemini / comparator functionality.
#

GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Hosted application URL.
# AI Studio may inject this automatically in hosted environments.
APP_URL="MY_APP_URL"


# ------------------------------------------------------------
# P2B Vision / Segmentation CUDA worker
# ------------------------------------------------------------

CUDA_VM_INFERENCE_ENDPOINT=http://127.0.0.1:8010

# Must match VM_SERVICE_TOKEN supplied to the VM Docker worker.
CUDA_VM_SERVICE_TOKEN=YOUR_VM_SERVICE_TOKEN

# Gateway health-check timeout.
CUDA_VM_STATUS_TIMEOUT_MS=2500

# Full segmentation inference timeout.
CUDA_VM_INFERENCE_TIMEOUT_MS=900000


# ------------------------------------------------------------
# P3.1 Qwen2-VL CUDA worker
# ------------------------------------------------------------

CUDA_VLM_INFERENCE_ENDPOINT=http://127.0.0.1:8020

# Must match VLM_SERVICE_TOKEN supplied to the VLM Docker worker.
CUDA_VLM_SERVICE_TOKEN=YOUR_VLM_SERVICE_TOKEN

# Gateway health-check timeout.
CUDA_VLM_STATUS_TIMEOUT_MS=2500

# Full Qwen inference timeout.
CUDA_VLM_INFERENCE_TIMEOUT_MS=900000